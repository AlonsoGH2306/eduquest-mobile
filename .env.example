# URL del backend de EduQuest (incluye /api/v1).
# auto: en desarrollo la app usa la misma IP de tu PC desde la que Expo carga la app (puerto 8080).
#       Funciona igual en el emulador y en un celular real conectado al mismo WiFi.
# Producción: https://<tu-backend-desplegado>/api/v1
EXPO_PUBLIC_API_URL=auto
